# Copy to .env (gitignored). Placeholder values only; never commit real ones.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local Postgres from `docker compose up -d` (repo root).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linkables
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/linkables
# Integration tests truncate every table, so they use their own database.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/linkables_test

# On Supabase: transaction pooler (runtime) and session pooler (migrations).
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres
# MIGRATION_DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# The JWKS URL and token issuer are derived from this.
SUPABASE_URL=https://your-project-ref.supabase.co

# Comma-separated bare origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

WORKER_ENABLED=false

# Optional: emails support@linkables.app about each new access request via Resend.
# RESEND_API_KEY=

# Test-only signing keys. Startup fails if this is set unless NODE_ENV=test.
# AUTH_TEST_JWKS=
