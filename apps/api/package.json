{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@linkaroo/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "parse5": "8.0.1",
    "postgres": "3.4.9",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
