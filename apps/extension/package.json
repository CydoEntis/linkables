{
  "name": "extension",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch --mode development",
    "release": "node scripts/release-zip.ts",
    "release:store": "vite build --mode store --outDir dist-store --emptyOutDir && node scripts/release-zip.ts store",
    "store:images": "node store/render.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test -c e2e"
  },
  "dependencies": {
    "@fontsource-variable/familjen-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@linkables/shared": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "cn": "0.4.0",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
