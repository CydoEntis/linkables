# Copy to .env (gitignored). Placeholder values only; never commit real ones.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The public anon key; it is shipped to the browser by design.
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:3000
# Where the magic link lands. Must be listed in Supabase Auth > URL Configuration > Redirect URLs.
VITE_AUTH_REDIRECT_URL=http://localhost:5173/
# Optional: the iCloud link to the "Save to linkables" iPhone Shortcut (docs/ios-shortcut.md).
# Leave empty until it exists; the app then says the shortcut is coming soon.
VITE_IOS_SHORTCUT_URL=
