{
	admin off
}

:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}
	handle /health {
		reverse_proxy api:3000
	}

	# Vite fingerprints everything under /assets. A missing one (an old tab
	# after a deploy) must 404, not fall back to index.html.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else (index.html, the manifest, icons) is re-checked so a
	# deploy shows up; unknown paths are SPA routes.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
