# Copy to /srv/linkables/.env on the server (chmod 600). Placeholders only.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Supabase pooler: transaction mode (6543) at runtime, session mode (5432) for
# migrations. URL-encode the password.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres
MIGRATION_DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://your-project-ref.supabase.co

# The app's own origin; the web container serves the SPA and the API from it.
# Then the Chrome extension twice: the hand-installed build, whose id is fixed by
# its manifest key (apps/extension/README.md), and the Chrome Web Store item,
# whose id the store assigned (apps/extension/STORE.md).
CORS_ORIGINS=https://linkables.app,chrome-extension://ekgbmopoceccloaibfknnbnohkpbkili,chrome-extension://dckjkoommfddaimpjbghbomojdkhaoai

WORKER_ENABLED=true

# Optional. Set, each new beta access request is emailed to support@linkables.app
# through Resend; empty, requests are only stored. A sending-only key is enough.
RESEND_API_KEY=

# Optional. The Supabase secret key (Project Settings > API Keys), which lets the
# extension sign in from linkables.app: the API mints a one-time sign-in token for
# the signed-in user through the auth admin API. Empty, the extension signs in
# with Google or an email code only. Never log or share it.
SUPABASE_SECRET_KEY=
